{
  "name": "cong-phone-backend",
  "version": "1.0.0",
  "description": "Backend for Cong Phone Shop",
  "main": "handler.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "setup": "node scripts/dev-setup.js",
    "dev": "NODE_OPTIONS='--max-old-space-size=1024 --no-experimental-detect-module --no-experimental-require-module' serverless offline",
    "dev:hot": "NODE_OPTIONS='--max-old-space-size=1024' serverless offline --reloadHandler",
    "dev:watch": "nodemon --exec \"npm run dev\" --watch src --ext ts,js,json",
    "dev:ts": "ts-node-dev --respawn --transpile-only --clear src/handler.ts",
    "deploy": "serverless deploy --force",
    "build": "tsc",
    "start": "node dist/handler.js",
    "test": "jest",
    "clean": "rm -rf .build .serverless node_modules/.cache dist",
    "seed": "ts-node src/scripts/seedData.ts",
    "seed:admin": "ts-node src/scripts/seedAdmin.ts",
    "seed:products": "ts-node src/scripts/seedProducts.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.400.0",
    "@aws-sdk/client-s3": "^3.400.0",
    "@aws-sdk/s3-request-presigner": "^3.400.0",
    "aws-lambda": "^1.0.7",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.2.1",
    "joi": "^17.9.2",
    "jose": "^5.1.3",
    "jsonwebtoken": "^9.0.1",
    "mongoose": "^7.4.3",
    "serverless-http": "^3.2.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.119",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.5.0",
    "esbuild": "^0.20.1",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "serverless": "^4.0.0",
    "serverless-dotenv-plugin": "^6.0.0",
    "serverless-offline": "^14.4.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.1.6"
  },
  "license": "MIT"
}
