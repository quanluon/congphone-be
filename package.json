{
  "name": "cong-phone-backend",
  "version": "1.0.0",
  "description": "Backend for Cong Phone Shop",
  "main": "index.js",
  "type": "commonjs",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "setup": "node scripts/dev-setup.js",
    "dev": "NODE_OPTIONS='--max-old-space-size=1024 --no-experimental-detect-module --no-experimental-require-module' yarn build && serverless offline",
    "dev:local": "ts-node-dev --respawn --transpile-only src/local.ts",
    "dev:hot": "NODE_OPTIONS='--max-old-space-size=1024' serverless offline --reloadHandler",
    "dev:watch": "nodemon --exec \"npm run dev\" --watch src --ext ts,js,json",
    "dev:ts": "ts-node-dev --respawn --transpile-only --clear src/handler.ts",
    "deploy": "yarn deploy:ecr && serverless deploy --force",
    "deploy:serverless": "serverless deploy --force",
    "build": "yarn build:shared && yarn build:lambda && yarn build:vercel",
    "build:shared": "BUILD_TARGET=all node esbuild.config.js",
    "build:lambda": "BUILD_TARGET=lambda node esbuild.config.js",
    "build:vercel": "BUILD_TARGET=vercel node esbuild.config.js",
    "build:tsc": "tsc && tsc-alias",
    "build:esbuild": "yarn build",
    "build:esbuild:prod": "NODE_ENV=production yarn build",
    "build:analyze": "yarn build:shared && yarn analyze:bundle",
    "analyze:bundle": "npx esbuild-visualizer --filename=dist/bundle-analysis.html --metadata=dist/build.meta.json",
    "analyze:deps": "node scripts/analyze-deps.js",
    "start": "node dist/handler.js",
    "test": "jest",
    "clean": "rm -rf .build .serverless node_modules/.cache dist",
    "seed": "ts-node src/scripts/seedData.ts",
    "seed:admin": "ts-node src/scripts/seedAdmin.ts",
    "seed:products": "ts-node src/scripts/seedProducts.ts",
    "docker:build": "docker build --platform linux/amd64 -t cong-phone-backend .",
    "docker:run": "docker run --platform linux/amd64 -p 3000:3000 --env-file .env cong-phone-backend",
    "docker:test": "yarn docker:build && yarn docker:run",
    "deploy:ecr": "bash scripts/deploy-ecr.sh",
    "deploy:ecr:tag": "bash scripts/deploy-ecr.sh"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.400.0",
    "@aws-sdk/client-s3": "^3.400.0",
    "@aws-sdk/s3-request-presigner": "^3.400.0",
    "aws-lambda": "^1.0.7",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.2.1",
    "joi": "^17.9.2",
    "jose": "^5.1.3",
    "jsonwebtoken": "^9.0.1",
    "mongoose": "^7.4.3",
    "openai": "^6.34.0",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.2",
    "serverless-http": "^3.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.119",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.5.0",
    "esbuild": "^0.20.1",
    "esbuild-visualizer": "^0.7.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "serverless": "^4.0.0",
    "serverless-dotenv-plugin": "^6.0.0",
    "serverless-offline": "^14.4.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.1.6"
  },
  "license": "MIT"
}
