{
  "watch": [
    "src/**/*.ts",
    "src/**/*.js",
    "src/**/*.json"
  ],
  "ext": "ts,js,json",
  "ignore": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "node_modules/**/*",
    "dist/**/*",
    ".build/**/*",
    ".serverless/**/*"
  ],
  "exec": "NODE_OPTIONS='--max-old-space-size=1024 --no-experimental-detect-module --no-experimental-require-module' serverless offline",
  "env": {
    "NODE_ENV": "development"
  },
  "delay": 1000,
  "verbose": true,
  "restartable": "rs",
  "colours": true,
  "runOnChangeOnly": false,
  "signal": "SIGTERM",
  "stdout": true,
  "legacyWatch": false
}
