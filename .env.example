# Application Configuration
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/cong-phone
MONGODB_NAME=cong-phone

# Firebase Configuration
FIREBASE_PROJECT_ID=your-firebase-project-id
# Optional fallback if you want to reuse the FE project id naming
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id

# AWS Core Configuration
AWS_REGION=ap-southeast-1

# AWS Cognito Configuration
COGNITO_USER_POOL_ID=your-cognito-user-pool-id
COGNITO_CLIENT_ID=your-cognito-client-id

# AWS S3 / Storage Configuration
S3_BUCKET=your-s3-bucket-name
CLOUDFRONT_STORAGE_ENDPOINT=https://your-cloudfront-storage-endpoint

# Optional AWS Credentials
# Use these for local development only when you are not relying on an IAM role.
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# Dashboard / Backoffice Links
DASHBOARD_URL=https://your-dashboard-domain

# Optional Telegram Notifications
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
TELEGRAM_MENTION_USER_IDS=1659457166

# Optional Local Dev Flags
HOT_RELOAD=true
WATCH_MODE=true
